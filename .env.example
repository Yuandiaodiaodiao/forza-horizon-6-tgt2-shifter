# Copy to .env and fill in local deployment values.
TGT2_WINDOWS_HOST=
TGT2_WINDOWS_USER=
TGT2_WINDOWS_PASSWORD=
TGT2_WINDOWS_PROJECT_DIR=
TGT2_WINDOWS_BUN_BIN=
TGT2_MAC_HOST=

# Local service configuration.
TGT2_WS_PORT=8765
TGT2_UDP_PORT=6688
TGT2_POLL_HZ=30
TGT2_TELEM_HZ=60
TGT2_JOY_ID=
TGT2_AUTO_SHIFT=true

# Key agent.
TGT2_KEY_AGENT_URL=
TGT2_KEY_AGENT_HOST=127.0.0.1
TGT2_KEY_AGENT_BIND_HOST=0.0.0.0
TGT2_KEY_AGENT_PORT=7788

# Mac proxy.
TGT2_PROXY_REMOTE_WS=
TGT2_PROXY_LOCAL_HOST=127.0.0.1
TGT2_PROXY_LOCAL_PORT=8766

# One-click app.
TGT2_DASHBOARD_HOST=127.0.0.1
TGT2_DASHBOARD_URL=
